# Copy this file to .env, fill in real values, and never commit .env itself.
# In production these are set in Netlify → Site settings → Environment variables.

# Supabase (Settings → API in your Supabase project)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, keep secret

# Safaricom Daraja (developer.safaricom.co.ke → My Apps)
MPESA_ENV=sandbox                # "sandbox" while testing, "production" when live
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379           # sandbox test paybill; replace with your real Till/Paybill
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_URL=https://your-site.netlify.app/.netlify/functions/stkcallback
